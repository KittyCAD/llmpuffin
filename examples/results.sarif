  "runs": [
    {
      "tool": {
        "driver": {
          "name": "llmpuffin",
          "version": "0.1.0",
          "rules": [
            {
              "id": "sqli-001",
              "shortDescription": {
                "text": "sqli-001"
              },
              "properties": {}
